;&gt;&lt;b&gt;COMP-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Definir planes de desarrollo para cerrar brechas de competencias.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, PlanDesarrollo, AccionDesarrollo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar actividades de capacitación, entrenamiento, práctica y desarrollo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AccionDesarrollo, ProgramaFormacion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar cursos, programas y otras modalidades de formación p.e. &quot;Onboarding&quot; incluyendo su documentación y versionamiento&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ProgramaFormacion, ContenidoFormativo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar calendarios y participantes de actividades de formación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;SesionFormacion, Participacion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar documentación, contenidos y versiones asociados a la formación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Documento, VersionDocumento, ContenidoFormativo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y evaluar los resultados y evidencias de aprendizaje y desarrollo, verificando el logro de los aprendizajes previstos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Evidencia, EvaluacionAprendizaje&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar seguimiento individual del desarrollo de competencias.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;CompetenciaPersona, PlanDesarrollo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar el seguimiento del acompañamiento, la tutoría, el coaching y otros mecanismos de desarrollo mediante la práctica continua y el aprendizaje&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, SesionAcompanamiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Asociar las competencias con los elementos de gestión necesarios para evaluar su desarrollo y aplicación, incluyendo desempeño, conocimiento, PTE y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, Competencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar, evaluar y priorizar oportunidades de mejora, determinando su tratamiento.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;OportunidadMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar problemas mediante su definición y análisis basado en evidencias, la identificación de causas, la determinación y seguimiento de acciones, y la verificación de resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Evidencia, Problema, AnalisisCausa, AccionMejora, VerificacionResultado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar iniciativas de mejora aprobadas desde su planificación hasta su cierre, registrando avances y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;IniciativaMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Brindar apoyo integral durante todo el ciclo de vida del Plan Anual de Acción para la Mejora Continua, incluyendo la definición de metas, la planificación de iniciativas, el seguimiento de resultados y su actualización, registrando las decisiones y los cambios correspondientes.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, Decision, RegistroCambio, PlanAnualMejora, MetaMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y canalizar sugerencias, ideas y propuestas de personas y equipos, vinculándolas con oportunidades de mejora cuando corresponda.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Sugerencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar los resultados y aprendizajes derivados de las acciones de mejora, facilitando su aprovechamiento en futuras mejoras.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;LeccionAprendida, ResultadoMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Asociar cada mejora con las entidades involucradas en su ejecución y evaluación, incluyendo conocimiento, competencias, PTE, procesos, proyectos y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Permitir configurar y aplicar diferentes métodos de mejora continua&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Analizar información histórica de múltiples casos de problemas y mejoras para identificar recurrencias, tendencias y patrones que permitan detectar oportunidades de mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisRecurrencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Configurar indicadores de gestión, desempeño, resultados y mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Indicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Definir fórmulas, fuentes, metas, periodicidad y responsables de indicadores.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;FormulaIndicador, MetaIndicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Visualizar información mediante dashboards configurables según perfiles y necesidades.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Dashboard, Widget&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Generar reportes operativos, tácticos y estratégicos SGCC configurables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Reporte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Analizar tendencias, desviaciones, cumplimiento y comportamiento de indicadores.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MedicionIndicador, AnalisisDesempeno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Relacionar indicadores con objetivos, proyectos, procesos, actividades y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, Indicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Facilitar análisis para toma de decisiones y priorización de acciones.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisDesempeno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Permitir configurar vistas e indicadores específicos para diferentes niveles, áreas y métodos de gestión.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, Dashboard&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="2470" width="1500" x="20" y="70" as="geometry"/>
                </mxCell>
            </root>
