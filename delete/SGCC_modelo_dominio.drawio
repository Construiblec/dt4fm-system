    <diagram id="pg9" name="Matriz RF - clases">
        <mxGraphModel dx="874" dy="535" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="2570" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p9c1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" value="&lt;b&gt;Matriz de trazabilidad RF → clases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Los 90 RF están soportados por al menos una clase del modelo.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="50" width="900" x="20" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="p9c2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#FFFFFF;strokeColor=#D1D5DB;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tr style=&quot;background:#E5E7EB&quot;&gt;&lt;th style=&quot;padding:4px 6px;text-align:left&quot;&gt;RF&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left&quot;&gt;Requisito funcional (ver3.2)&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left&quot;&gt;Clases que lo soportan&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar organizaciones, unidades, áreas, procesos, roles y demás estructuras organizativas configurables&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Organizacion, UnidadOrganizativa, Proceso, Rol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar usuarios, perfiles, roles y permisos de acceso conforme a las responsabilidades definidas por la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Rol, Persona, Usuario, Perfil, Permiso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Configurar catálogos, parámetros, estados, tipos, categorías y reglas utilizados por los componentes del SGCC.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, Catalogo, ValorCatalogo, ReglaNegocio, ParametroSistema&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar flujos de trabajo configurables según procesos y reglas de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Proceso, ReglaNegocio, FlujoTrabajo, EtapaFlujo, TransicionFlujo, InstanciaFlujo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar documentos, registros, evidencias y versiones asociados a las actividades del SGCC.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, Documento, VersionDocumento, Evidencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Integrarse mediante interfaces con sistemas externos e importar/exportar información estructurada en formatos definidos, validando su integridad y respetando los permisos de acceso.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Permiso, InterfazIntegracion, OperacionIntercambio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Mantener trazabilidad de usuarios, acciones, cambios, estados y registros relevantes del sistema.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, RegistroAuditoria&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar el análisis estratégico de factores internos y externos relevantes para la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisEstrategico, FactorEstrategico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar información de prospectiva, escenarios, tendencias y condiciones futuras relevantes para la planificación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;EstudioProspectivo, Escenario, Tendencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Definir OEs, prioridades y resultados estratégicos de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ObjetivoEstrategico, PrioridadEstrategica&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Desagregar objetivos estratégicos en niveles, resultados, hitos o compromisos según el modelo adoptado.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco, ObjetivoEstrategico, ElementoDesagregado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar indicadores y metas asociados a objetivos y prioridades estratégicas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ObjetivoEstrategico, Indicador, MetaIndicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar responsables, plazos, recursos y condiciones de ejecución asociados a las prioridades estratégicas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;PrioridadEstrategica, AsignacionEjecucion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Brindar apoyo integral durante todo el ciclo de vida del Plan Estratégico y de los Planes anuales de Acción asociados a cada objetivo estratégico, registrando todas las decisiones y los cambios derivados de esas decisiones.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, Decision, RegistroCambio, FlujoTrabajo, PlanEstrategico, PlanAnualAccion, CicloRevision&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;RUG-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;EvaluacionMadurezRitmos, DimensionRitmo, BrechaMadurez&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la relación entre prioridades estratégicas, recursos disponibles y recursos requeridos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;PrioridadEstrategica, Recurso, RequerimientoRecurso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la planificación y seguimiento de inversiones y recursos destinados a OEs.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;InversionEstrategica&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la capacidad disponible de recursos humanos frente a las necesidades derivadas de prioridades y planes.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Persona, CapacidadPersona&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Analizar y visualizar el equilibrio entre prioridades, capacidad, recursos, inversiones y resultados esperados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisEquilibrio, Dashboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GDD-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar el Plan de Gestión del Desempeño, incluyendo la planificación de compromisos, actividades y resultados, y su seguimiento continuo en los diferentes niveles de la organización, manteniendo trazabilidad con los objetivos estratégicos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, PlanGestionDesempeno, CompromisoDesempeno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GDD-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar ciclos de revisión del desempeño y registrar desviaciones, decisiones, acciones de mejora y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Decision, CicloRevision, Desviacion, AccionMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, PlanCortoPlazo, Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar responsables, fechas, duración, prioridades, recursos y restricciones de las actividades planificadas, incluyendo recordatorios de tareas pendientes a sus responsables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Recurso, Actividad, Recordatorio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y comparar ejecución planificada, real, reprogramada y no planificada, midiendo los factores de estabilidad y equilibrio de procesos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;RegistroEjecucion, MedicionEstabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar resultados, evidencias, desviaciones y causas de actividades no ejecutadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Evidencia, Desviacion, ResultadoActividad, CausaNoEjecucion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Crear y gestionar proyectos con objetivos, alcance, responsables, fechas, estado, patrocinador y justificación del negocio cuando aplique manteniendo su alineación y trazabilidad con los OEs y el Sistema de gestión vigente&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar estructura, fases, hitos, entregables, ciclos de vida predictivos, ágiles e hibridos según el proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;FaseProyecto, Hito, Entregable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar actividades, tareas, responsables y dependencias del proyecto y permitir backlogs, historias de usuario y sprints cuando corresponda&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Actividad, TareaProyecto, Backlog, HistoriaUsuario, Sprint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar cronogramas, seguimiento del avance, planificación iterativa, hitos y pronósticos de finalización del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Hito, Sprint, Cronograma&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar recursos, costos, necesidades, presu- puestos de referencia y seguimientos de desvia- ciones del proyecto incluyendo adquisiciones e información de proveedores asociadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Recurso, Desviacion, PresupuestoProyecto, PartidaCosto, Adquisicion, Proveedor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar riesgos potenciales, problemas materializados, impedimentos, restricciones y oportunidades del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;RegistroRiesgoProblema&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar cambios con evaluación de su impacto en: alcance, plazo, recursos, costos, calidad y valor esperado del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;SolicitudCambio, EvaluacionImpacto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar documentación, versiones, entregables, evidencias y conocimiento generado durante el proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Documento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar y registrar responsables, fechas, decisiones, acuerdos, compromisos asociados al proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Decision&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&g