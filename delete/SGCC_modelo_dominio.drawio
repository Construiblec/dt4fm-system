x solid #E5E7EB;vertical-align:top&quot;&gt;Utilizar los PTE como referencia para ejecutar actividades mediante la generación de POp´s&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;POp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Identificar/registrar desviaciones, desperdicios, incidencias y oportunidades de mejora relacionadas con los PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;HallazgoPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Actualizar PTE a partir de resultados, aprendizajes, cambios y mejoras aprobadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VersionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y conservar evidencias de aplicación, revisión y evolución de cada PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VersionDocumento, Evidencia, RevisionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-08&lt;/b&gt;&lt;/