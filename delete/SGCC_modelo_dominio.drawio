&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Capturar conocimiento explícito generado en las actividades de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Capturar conocimiento tácito, experiencias, prácticas y aprendizajes de las personas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Organizar, clasificar y relacionar conocimiento según estructuras configurables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Taxonomia, CategoriaConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar libros, papers, documentos, evidencias, registros, videos, charlas y fuentes asociados al conocimiento.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px 