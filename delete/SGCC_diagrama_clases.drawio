                <mxCell id="om302" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;" value="&lt;b&gt;ReunionDecision&lt;/b&gt;: Reuniones → Decision (1:N)&lt;br&gt;&lt;b&gt;ActividadMaintProcess&lt;/b&gt;: Actividad → MaintProcess (N:N)&lt;br&gt;&lt;b&gt;ActividadCleaningTask&lt;/b&gt;: Actividad → CleaningTask (N:N)&lt;br&gt;&lt;b&gt;PtePrevMaintConfig&lt;/b&gt;: PTE → PrevMaintConfig (1:N)&lt;br&gt;&lt;b&gt;PteCleaningActivity&lt;/b&gt;: PTE → CleaningActivity (1:N)&lt;br&gt;&lt;b&gt;PteMaintenanceManual&lt;/b&gt;: PTE → MaintenanceManual (N:N)&lt;br&gt;&lt;b&gt;ProblemaCorrectiveMaint&lt;/b&gt;: Problema → CorrectiveMaint (N:N)&lt;br&gt;&lt;b&gt;ProblemaCI&lt;/b&gt;: Problema → CI (N:N)&lt;br&gt;&lt;b&gt;AccionMejoraMaintProcess&lt;/b&gt;: AccionMejora → MaintProcess (1:N)&lt;br&gt;&lt;b&gt;LeccionCorrectiveMaint&lt;/b&gt;: LeccionAprendida → CorrectiveMaint (N:N)&lt;br&gt;&lt;b&gt;EmployeeCompetencia&lt;/b&gt;: Employee → CompetenciaPersona (1:N)&lt;br&gt;&lt;b&gt;CompanyUnidadOrg&lt;/b&gt;: Company → UnidadOrganizativa (1:N)&lt;br&gt;&lt;b&gt;UnidadOrgTeam&lt;/b&gt;: UnidadOrganizativa → Team (1:N)&lt;br&gt;&lt;b&gt;SiteActivoConocimiento&lt;/b&gt;: Site → ActivoConocimiento (1:N)&lt;br&gt;&lt;b&gt;EmployeeSugerencia&lt;/b&gt;: Employee → Sugerencia (1:N)&lt;br&gt;&lt;b&gt;TenantSugerencia&lt;/b&gt;: Tenant → Sugerencia (1:N)" vertex="1">
