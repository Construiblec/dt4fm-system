    <diagram id="pg10" name="Matriz RF - clases">
        <mxGraphModel dx="3504" dy="2568" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="2570" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p10c1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" value="&lt;b&gt;Matriz de trazabilidad RF → clases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Los 90 RF están soportados por al menos una clase del modelo.&lt;/font&gt;" vertex="1">
                    <mxGeometry height="50" width="900" x="20" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="p10c2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#FFFFFF;strokeColor=#D1D5DB;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tr style=&quot;background:#E5E7EB&quot;&gt;&lt;th style=&quot;padding:4px 6px;text-align:left&quot;&gt;RF&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left&quot;&gt;Requisito funcional (ver3.2)&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left&quot;&gt;Clases que lo soportan&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar organizaciones, unidades, áreas, procesos, roles y demás estructuras organizativas configurables&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Organizacion, UnidadOrganizativa, Proceso, Rol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar usuarios, perfiles, roles y permisos de acceso conforme a las responsabilidades definidas por la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Rol, Persona, Usuario, Perfil, Permiso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Configurar catálogos, parámetros, estados, tipos, categorías y reglas utilizados por los componentes del SGCC.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, Catalogo, ValorCatalogo, ReglaNegocio, ParametroSistema&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar flujos de trabajo configurables según procesos y reglas de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Proceso, ReglaNegocio, FlujoTrabajo, EtapaFlujo, TransicionFlujo, InstanciaFlujo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar documentos, registros, evidencias y versiones asociados a las actividades del SGCC.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, Documento, VersionDocumento, Evidencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Integrarse mediante interfaces con sistemas externos e importar/exportar información estructurada en formatos definidos, validando su integridad y respetando los permisos de acceso.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Permiso, InterfazIntegracion, OperacionIntercambio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;ADM-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Mantener trazabilidad de usuarios, acciones, cambios, estados y registros relevantes del sistema.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, RegistroAuditoria&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar el análisis estratégico de factores internos y externos relevantes para la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisEstrategico, FactorEstrategico&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar información de prospectiva, escenarios, tendencias y condiciones futuras relevantes para la planificación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;EstudioProspectivo, Escenario, Tendencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Definir OEs, prioridades y resultados estratégicos de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ObjetivoEstrategico, PrioridadEstrategica&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Desagregar objetivos estratégicos en niveles, resultados, hitos o compromisos según el modelo adoptado.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco, ObjetivoEstrategico, ElementoDesagregado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar indicadores y metas asociados a objetivos y prioridades estratégicas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ObjetivoEstrategico, Indicador, MetaIndicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar responsables, plazos, recursos y condiciones de ejecución asociados a las prioridades estratégicas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;PrioridadEstrategica, AsignacionEjecucion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PGE-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Brindar apoyo integral durante todo el ciclo de vida del Plan Estratégico y de los Planes anuales de Acción asociados a cada objetivo estratégico, registrando todas las decisiones y los cambios derivados de esas decisiones.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, Decision, RegistroCambio, FlujoTrabajo, PlanEstrategico, PlanAnualAccion, CicloRevision&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;RUG-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;EvaluacionMadurezRitmos, DimensionRitmo, BrechaMadurez&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la relación entre prioridades estratégicas, recursos disponibles y recursos requeridos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;PrioridadEstrategica, Recurso, RequerimientoRecurso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la planificación y seguimiento de inversiones y recursos destinados a OEs.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;InversionEstrategica&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la capacidad disponible de recursos humanos frente a las necesidades derivadas de prioridades y planes.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Persona, CapacidadPersona&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;EIE-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Analizar y visualizar el equilibrio entre prioridades, capacidad, recursos, inversiones y resultados esperados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisEquilibrio, Dashboard&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GDD-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar el Plan de Gestión del Desempeño, incluyendo la planificación de compromisos, actividades y resultados, y su seguimiento continuo en los diferentes niveles de la organización, manteniendo trazabilidad con los objetivos estratégicos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, PlanGestionDesempeno, CompromisoDesempeno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GDD-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar ciclos de revisión del desempeño y registrar desviaciones, decisiones, acciones de mejora y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Decision, CicloRevision, Desviacion, AccionMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, PlanCortoPlazo, Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar responsables, fechas, duración, prioridades, recursos y restricciones de las actividades planificadas, incluyendo recordatorios de tareas pendientes a sus responsables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Recurso, Actividad, Recordatorio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y comparar ejecución planificada, real, reprogramada y no planificada, midiendo los factores de estabilidad y equilibrio de procesos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;RegistroEjecucion, MedicionEstabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GOCP-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar resultados, evidencias, desviaciones y causas de actividades no ejecutadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Evidencia, Desviacion, ResultadoActividad, CausaNoEjecucion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Crear y gestionar proyectos con objetivos, alcance, responsables, fechas, estado, patrocinador y justificación del negocio cuando aplique manteniendo su alineación y trazabilidad con los OEs y el Sistema de gestión vigente&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar estructura, fases, hitos, entregables, ciclos de vida predictivos, ágiles e hibridos según el proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;FaseProyecto, Hito, Entregable&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar actividades, tareas, responsables y dependencias del proyecto y permitir backlogs, historias de usuario y sprints cuando corresponda&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Actividad, TareaProyecto, Backlog, HistoriaUsuario, Sprint&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar cronogramas, seguimiento del avance, planificación iterativa, hitos y pronósticos de finalización del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Hito, Sprint, Cronograma&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar recursos, costos, necesidades, presu- puestos de referencia y seguimientos de desvia- ciones del proyecto incluyendo adquisiciones e información de proveedores asociadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Recurso, Desviacion, PresupuestoProyecto, PartidaCosto, Adquisicion, Proveedor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar riesgos potenciales, problemas materializados, impedimentos, restricciones y oportunidades del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;RegistroRiesgoProblema&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar cambios con evaluación de su impacto en: alcance, plazo, recursos, costos, calidad y valor esperado del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;SolicitudCambio, EvaluacionImpacto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar documentación, versiones, entregables, evidencias y conocimiento generado durante el proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Documento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar y registrar responsables, fechas, decisiones, acuerdos, compromisos asociados al proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Decision&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar seguimiento y evaluación de resultados, aceptación de entregables y cumplimiento de objetivos y beneficios del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Entregable, EvaluacionResultados&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar los aprendizajes y conocimientos generados durante el ciclo de vida del proyecto, asociarlos al proyecto correspondiente y faiclitar su reutilización&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;LeccionAprendida&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Vincular el proyecto con objetivos, procesos y conocimiento alineados a las entidades organizacionales, competencias y oportunidades de mejora&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, Proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PRO-13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Capturar conocimiento explícito generado en las actividades de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Capturar conocimiento tácito, experiencias, prácticas y aprendizajes de las personas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Organizar, clasificar y relacionar conocimiento según estructuras configurables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Taxonomia, CategoriaConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar libros, papers, documentos, evidencias, registros, videos, charlas y fuentes asociados al conocimiento.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Documento, FuenteConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar la valoración de los usuarios sobre la utilidad práctica del conocimiento, considerando la frecuencia e importancia de su uso para resolver problemas, y permitir consultar los resultados para priorizar su mejora y reutilización versionada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VersionConocimiento, ValoracionUtilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar la transferencia y socialización del conocimiento, la cultura y los valores dentro de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;EventoSocializacion, ElementoCultural&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar aprendizajes, lecciones y experiencias derivados de la ejecución y mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;LeccionAprendida&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;KN-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar un Plan de Manejo del Conocimiento incluyendo la planificación, ciclos de creación, transformación, validación, actualización y aplicación del conocimiento; registrando el contexto físico, virtual o digital en el que se genera y/o aplica.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, MarcoMetodologico, VersionConocimiento, PlanManejoConocimiento, CicloConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;TR-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Consultar y navegar transversalmente las relaciones existentes entre OEs, proyectos, procesos, activida- des, resultados, conocimiento, PTE, competencias y mejoras, permitiendo seguir la trazabilidad desde las experiencias que originan conocimiento hasta su aplicación mediante PTE, el desarrollo de competencias y los resultados obtenidos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, ConsultaTrazabilidad, GrafoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;TR-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;TrazaConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;TR-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Mantener trazabilidad entre conocimiento, competencias, personas y actividades de desarrollo.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, ConsultaTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;TR-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;TrazaConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;TR-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Mantener historial de cambios, decisiones, versiones y estados de elementos gestionados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ElementoGestion, Decision, RegistroCambio, RegistroAuditoria, HistorialElemento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;TR-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, ConsultaTrazabilidad, GrafoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;PTE, FormatoPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar versiones, revisiones, aprobación y vigencia de los PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;FlujoTrabajo, CicloRevision, VersionPTE, RevisionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Asociar cada PTE con los procesos, actividades, competencias, conocimiento y demás entidades necesarias para su aplicación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, PTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Utilizar los PTE como referencia para ejecutar actividades mediante la generación de POp´s&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;POp&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Identificar/registrar desviaciones, desperdicios, incidencias y oportunidades de mejora relacionadas con los PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;HallazgoPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Actualizar PTE a partir de resultados, aprendizajes, cambios y mejoras aprobadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VersionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y conservar evidencias de aplicación, revisión y evolución de cada PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VersionDocumento, Evidencia, RevisionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;PTE-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Priorizar el levantamiento de PTE según su importancia estratégica y su frecuencia de uso operativo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;PrioridadLevantamiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar perfiles y competencias requeridas por roles y actividades.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Rol, Competencia, PerfilCompetencias, CompetenciaRequerida&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar competencias actuales de las personas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Persona, CompetenciaPersona&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Identificar brechas entre competencias requeridas y disponibles.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;BrechaCompetencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Definir planes de desarrollo para cerrar brechas de competencias.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, PlanDesarrollo, AccionDesarrollo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar actividades de capacitación, entrenamiento, práctica y desarrollo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AccionDesarrollo, ProgramaFormacion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar cursos, programas y otras modalidades de formación p.e. &quot;Onboarding&quot; incluyendo su documentación y versionamiento&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;ProgramaFormacion, ContenidoFormativo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar calendarios y participantes de actividades de formación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;SesionFormacion, Participacion&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar documentación, contenidos y versiones asociados a la formación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Documento, VersionDocumento, ContenidoFormativo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y evaluar los resultados y evidencias de aprendizaje y desarrollo, verificando el logro de los aprendizajes previstos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Evidencia, EvaluacionAprendizaje&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar seguimiento individual del desarrollo de competencias.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;CompetenciaPersona, PlanDesarrollo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar el seguimiento del acompañamiento, la tutoría, el coaching y otros mecanismos de desarrollo mediante la práctica continua y el aprendizaje&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, SesionAcompanamiento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;COMP-12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Asociar las competencias con los elementos de gestión necesarios para evaluar su desarrollo y aplicación, incluyendo desempeño, conocimiento, PTE y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, Competencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar, evaluar y priorizar oportunidades de mejora, determinando su tratamiento.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;OportunidadMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar problemas mediante su definición y análisis basado en evidencias, la identificación de causas, la determinación y seguimiento de acciones, y la verificación de resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Evidencia, Problema, AnalisisCausa, AccionMejora, VerificacionResultado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Gestionar iniciativas de mejora aprobadas desde su planificación hasta su cierre, registrando avances y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;IniciativaMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Brindar apoyo integral durante todo el ciclo de vida del Plan Anual de Acción para la Mejora Continua, incluyendo la definición de metas, la planificación de iniciativas, el seguimiento de resultados y su actualización, registrando las decisiones y los cambios correspondientes.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Plan, Decision, RegistroCambio, PlanAnualMejora, MetaMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar y canalizar sugerencias, ideas y propuestas de personas y equipos, vinculándolas con oportunidades de mejora cuando corresponda.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Sugerencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Registrar los resultados y aprendizajes derivados de las acciones de mejora, facilitando su aprovechamiento en futuras mejoras.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;LeccionAprendida, ResultadoMejora&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Asociar cada mejora con las entidades involucradas en su ejecución y evaluación, incluyendo conocimiento, competencias, PTE, procesos, proyectos y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Permitir configurar y aplicar diferentes métodos de mejora continua&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GMC-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Analizar información histórica de múltiples casos de problemas y mejoras para identificar recurrencias, tendencias y patrones que permitan detectar oportunidades de mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisRecurrencia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Configurar indicadores de gestión, desempeño, resultados y mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Indicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Definir fórmulas, fuentes, metas, periodicidad y responsables de indicadores.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;FormulaIndicador, MetaIndicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Visualizar información mediante dashboards configurables según perfiles y necesidades.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Dashboard, Widget&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Generar reportes operativos, tácticos y estratégicos SGCC configurables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Reporte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Analizar tendencias, desviaciones, cumplimiento y comportamiento de indicadores.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MedicionIndicador, AnalisisDesempeno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Relacionar indicadores con objetivos, proyectos, procesos, actividades y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;VinculoTrazabilidad, Indicador&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Facilitar análisis para toma de decisiones y priorización de acciones.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;AnalisisDesempeno&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;font-family:Courier New;white-space:nowrap;vertical-align:top&quot;&gt;&lt;b&gt;GID-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;Permitir configurar vistas e indicadores específicos para diferentes niveles, áreas y métodos de gestión.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #E5E7EB;vertical-align:top&quot;&gt;MarcoMetodologico, Dashboard&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
                    <mxGeometry height="2470" width="1500" x="20" y="70" as="geometry"/>
                </mxCell>
            </root>
