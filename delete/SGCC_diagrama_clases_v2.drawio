tSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#4B5563;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;" vertex="1" connectable="0" parent="c58"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c60" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=10;" vertex="1" connectable="0" parent="c58"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="v2lk" name="Catálogos (lookups)"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Catálogos (lookups)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Sustituyen a las 39 enumeraciones de la v1; se crean como lookup types de CMDBuild y se pueden ampliar sin tocar el modelo.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="t2" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tr style=&quot;background:#E5E7EB&quot;&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:30%&quot;&gt;Lookup type&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:70%&quot;&gt;Valores iniciales&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoMarco&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;HK, OKR, PMI, Scrum, SECI, A3, TBP, Coaching Kata…&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoComponente&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;nivel, fase, artefacto, ceremonia, paso, técnica&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoVinculo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;deriva de, mide, origina, aplica, transfiere, estandariza…&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - EtapaTraza&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;origen, transformación, destino, uso&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoPlan&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;estratégico, anual de acción, desempeño, corto plazo, manejo del conocimiento, desarrollo, anual de mejora&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoActividad&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;tarea, hito, historia de usuario, acción de mejora, acción de desarrollo, POp, operativa&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoEjecucion&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;planificada, real, reprogramada, no planificada&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoResultado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;actividad, entregable, mejora, verificación, evaluación de proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoAnalisis&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;estratégico, prospectivo, madurez de ritmos, equilibrio, causa raíz, recurrencia, desempeño&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoFactor&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;factor interno/externo, escenario, tendencia, dimensión de ritmo, causa, patrón&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoRecurso&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;persona, activo, consumible, dinero&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoHallazgo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;desviación, riesgo, problema, impedimento, restricción, oportunidad, sugerencia, desperdicio, incidencia&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - Tratamiento&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;descartar, acción directa, problema (A3), iniciativa, proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoIndicador / Sentido / Periodicidad / NivelGestion&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;gestión, desempeño, resultado, mejora · ↑ ↓ = · diaria…anual · operativo, táctico, estratégico&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoConocimiento&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;explícito, tácito, lección aprendida, práctica, elemento cultural, valor&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - Contexto / FaseConocimiento&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;físico, virtual, digital · socialización, externalización, combinación, internalización&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoReunion&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;revisión de desempeño, socialización, formación, acompañamiento, proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoCompetencia / TipoPrograma&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;técnica, conductual… · curso, onboarding, programa&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SGCC - TipoUnidad / TipoProceso / TipoFase&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;gerencia, área, equipo · estratégico, operativo, apoyo · fase, sprint, iteración&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Reutilizados de OpenMaint&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMMON - Priority, COMMON - Criticality, MaintProcess - SuspensionReason (causa de no ejecución)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1400" height="550" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v2sp" name="Simplificación v1 → v2"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Simplificación v1 → v2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Destino de cada una de las 130 clases de la v1.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="t2" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tr style=&quot;background:#E5E7EB&quot;&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:30%&quot;&gt;Clase v1&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:70%&quot;&gt;En la v2&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoGestion&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoGestion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico&lt;/td&g