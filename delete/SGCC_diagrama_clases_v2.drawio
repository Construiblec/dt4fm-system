<mxfile host="65bd71144e" agent="SGCC v2"><diagram id="v2p0" name="Vista general"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="o1" value="&lt;b&gt;SGCC v2 · Vista general (simplificada sobre OpenMaint)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;v1: 130 clases + 39 enumeraciones → v2: 33 elementos nuevos (2 son dominios), 18 clases de OpenMaint reutilizadas y 12 funciones nativas de CMDBuild. Los 90 RF siguen cubiertos (página «Matriz RF»). Todas las clases nuevas heredan de ElementoGestion salvo las marcadas como detalle, dominio o proceso.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="70" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;Núcleo y ADM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;Núcleo transversal y administración&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ElementoGestion&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Aprobacion&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; MarcoMetodologico&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ComponenteMarco&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Decision&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; VinculoTrazabilidad&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; UnidadOrganizativa&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ProcesoNegocio&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; RolFuncional&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Company&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Employee&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; User" style="shape=folder;tabWidth=160;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=24;fontSize=11;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="262" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Planificación y ejecución&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;PGE · RUG · EIE · GDD · GOCP&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Plan&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ElementoPlan&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Actividad&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; RegistroEjecucion&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Resultado&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Analisis&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; FactorAnalisis&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; AsignacionRecurso&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Budget&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; BudgetItem&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; AccountingMov&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; MaintProcess&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; CleaningTask&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; CI&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Consumable" style="shape=folder;tabWidth=160;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=24;fontSize=11;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="260" height="310" as="geometry"/></mxCell><mxCell id="o4" value="&lt;b&gt;Proyectos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;PRO&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Proyecto&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; SolicitudCambio&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; FaseProyecto&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; PurchaseOrder&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Supplier&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Site" style="shape=folder;tabWidth=160;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=24;fontSize=11;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="260" height="166" as="geometry"/></mxCell><mxCell id="o5" value="&lt;b&gt;Mejora e indicadores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;GMC · GID&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Hallazgo&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Indicador&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; MedicionIndicador&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; MaintSLA&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Tenant" style="shape=folder;tabWidth=160;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=24;fontSize=11;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="260" height="150" as="geometry"/></mxCell><mxCell id="o6" value="&lt;b&gt;Conocimiento y PTE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;KN · TR · PTE&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ActivoConocimiento&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ValoracionUtilidad&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; CicloConocimiento&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; PTE&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; VersionPTE&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; Reuniones&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; CleaningActivity&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;■&lt;/font&gt; PrevMaintConfig" style="shape=folder;tabWidth=160;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=24;fontSize=11;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="330" y="440" width="260" height="198" as="geometry"/></mxCell><mxCell id="o7" value="&lt;b&gt;Competencias&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;COMP&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; CompetenciaRequerida&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Competencia&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; CompetenciaPersona&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; Participacion&lt;br&gt;&lt;font color=&quot;#4338CA&quot;&gt;■&lt;/font&gt; ProgramaFormacion" style="shape=folder;tabWidth=160;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=24;fontSize=11;fillColor=#EEF2FF;strokeColor=#4338CA;" vertex="1" parent="1"><mxGeometry x="620" y="440" width="260" height="150" as="geometry"/></mxCell><mxCell id="o8" value="&lt;b&gt;Plataforma CMDBuild / OpenMaint&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Grupos y privilegios&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: Perfil, Permiso&lt;/font&gt;&lt;br&gt;&lt;b&gt;Lookups&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: Catalogo, ValorCatalogo, Taxonomia, CategoriaConocimiento y las 39 enumeraciones&lt;/font&gt;&lt;br&gt;&lt;b&gt;Parameter (OpenMaint)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: ParametroSistema&lt;/font&gt;&lt;br&gt;&lt;b&gt;Workflow&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: FlujoTrabajo, EtapaFlujo, TransicionFlujo, InstanciaFlujo&lt;/font&gt;&lt;br&gt;&lt;b&gt;Funciones y form triggers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: ReglaNegocio&lt;/font&gt;&lt;br&gt;&lt;b&gt;DMS Alfresco&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: Documento, VersionDocumento, Evidencia, FuenteConocimiento, ContenidoFormativo, FormatoPTE, VersionConocimiento&lt;/font&gt;&lt;br&gt;&lt;b&gt;Historial de tarjetas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: RegistroCambio, RegistroAuditoria, HistorialElemento&lt;/font&gt;&lt;br&gt;&lt;b&gt;Grafo de relaciones&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: ConsultaTrazabilidad, GrafoTrazabilidad&lt;/font&gt;&lt;br&gt;&lt;b&gt;Import/export y ETL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: InterfazIntegracion, OperacionIntercambio&lt;/font&gt;&lt;br&gt;&lt;b&gt;Notificaciones (EmailTemplate, HistorialEmail)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: Recordatorio&lt;/font&gt;&lt;br&gt;&lt;b&gt;Dashboards y reportes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: Dashboard, Widget, Reporte&lt;/font&gt;&lt;br&gt;&lt;b&gt;Vistas SQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;sustituye a: MedicionEstabilidad, Cronograma, Backlog, BrechaCompetencia, CapacidadPersona&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="420" height="640" as="geometry"/></mxCell><mxCell id="o9" value="&lt;b&gt;Criterios de simplificación&lt;/b&gt;&lt;br&gt;1. Lo que ya existe en OpenMaint se usa con su nombre real (Employee, Company, Supplier, Budget, Reuniones…).&lt;br&gt;2. Lo que CMDBuild ya resuelve (permisos, catálogos, flujos, DMS, historial, grafo, dashboards) no se modela.&lt;br&gt;3. Las clases con la misma forma se unen y se distinguen por un lookup de tipo: 7 planes → Plan; objetivos, prioridades, compromisos, metas e iniciativas → ElementoPlan; tareas, hitos, historias, acciones y POp → Actividad; desviaciones, riesgos, problemas, oportunidades, sugerencias y hallazgos de PTE → Hallazgo; 5 análisis → Analisis + FactorAnalisis; entregables y resultados → Resultado; recursos, capacidad e inversión → AsignacionRecurso; sesiones y revisiones → Reuniones.&lt;br&gt;4. Los niveles que dependen del método (objetivo, resultado clave, compromiso…) vienen de ComponenteMarco: cambiar HK por OKR es configuración, no rediseño.&lt;br&gt;5. Un único flujo Aprobacion sirve para planes, solicitudes de cambio y versiones de PTE.&lt;br&gt;6. Lo calculable (brechas, cronograma, backlog, estabilidad, capacidad) son vistas SQL, no clases." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFFFF;strokeColor=#9CA3AF;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="1320" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v2p1" name="Núcleo y ADM"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Núcleo y ADM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Diagrama de clases (diseño) v2 · SGCC sobre OpenMaint · Núcleo transversal y administración · cajas punteadas: clases de otra página · azul: nueva · naranja: OpenMaint · violeta: proceso · verde: dominio&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;font style=&quot;font-size:9px&quot;&gt;«abstract»&lt;/font&gt;&lt;br&gt;&lt;b&gt;ElementoGestion&lt;/b&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=38;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#C7D2FE;swimlaneFillColor=#FFFFFF;strokeColor=#4338CA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="359" as="geometry"/></mxCell><mxCell id="c3" value="codigo : String&lt;br&gt;nombre : String&lt;br&gt;descripcion : Text&lt;br&gt;tipo : Lookup&lt;br&gt;estado : Lookup&lt;br&gt;prioridad : Lookup (COMMON - Priority)&lt;br&gt;fechaInicio : Date&lt;br&gt;fechaFin : Date&lt;br&gt;responsable : Ref(Employee)&lt;br&gt;unidad : Ref(UnidadOrganizativa)&lt;br&gt;marco : Ref(MarcoMetodologico)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="c2"><mxGeometry y="38" width="300" height="173" as="geometry"/></mxCell><mxCell id="c4" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#4338CA;" vertex="1" parent="c2"><mxGeometry y="211" width="300" height="8" as="geometry"/></mxCell><mxCell id="c5" value="+ cambiarEstado(nuevo:Lookup) : void&lt;br&gt;+ vincular(destino:ElementoGestion, tipo:Lookup) : void&lt;br&gt;+ adjuntar(archivo:Binario, categoria:Lookup) : void&lt;br&gt;+ historial() : List&amp;lt;Version&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="c2"><mxGeometry y="219" width="300" height="98" as="geometry"/></mxCell><mxCell id="c6" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#4338CA;" vertex="1" parent="c2"><mxGeometry y="317" width="300" height="8" as="geometry"/></mxCell><mxCell id="c7" value="superclase prototipo SgccElemento · RF: ADM-03, ADM-05, ADM-07, TR-05" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=9;fontColor=#6B7280;" vertex="1" parent="c2"><mxGeometry y="325" width="300" height="34" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font style=&quot;font-size:9px&quot;&gt;«proceso CMDBuild»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Aprobacion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#374151&quot;&gt;hereda de Process&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=53;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#E9D5FF;swimlaneFillColor=#FFFFFF;strokeColor=#7E22CE;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="539" width="300" height="254" as="geometry"/></mxCell><mxCell id="c9" value="elemento : Ref(ElementoGestion)&lt;br&gt;tipoAprobacion : Lookup&lt;br&gt;aprobador : Ref(Employee)&lt;br&gt;resultado : Lookup (aprobado, observado, rechazado)&lt;br&gt;comentario : Text&lt;br&gt;fechaResolucion : DateTime" style="text;strokeColor=no