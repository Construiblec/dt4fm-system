</root></mxGraphModel></diagram><diagram id="v2rf" name="Matriz RF - clases"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Matriz de trazabilidad RF → clases (v2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7280&quot;&gt;Los 90 RF siguen soportados. «(CMDBuild)» = función nativa; «(OpenMaint)» = clase existente.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="t2" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tr style=&quot;background:#E5E7EB&quot;&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:8%&quot;&gt;RF&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:52%&quot;&gt;Requisito funcional (ver3.2)&lt;/th&gt;&lt;th style=&quot;padding:4px 6px;text-align:left;width:40%&quot;&gt;Clases v2 que lo soportan&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar organizaciones, unidades, áreas, procesos, roles y demás estructuras organizativas configurables&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Company (OpenMaint), UnidadOrganizativa, ProcesoNegocio, RolFuncional, Grupos y privilegios (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar usuarios, perfiles, roles y permisos de acceso conforme a las responsabilidades definidas por la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;RolFuncional, Grupos y privilegios (CMDBuild), Employee (OpenMaint), User (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Configurar catálogos, parámetros, estados, tipos, categorías y reglas utilizados por los componentes del SGCC.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoGestion, Lookups (CMDBuild), Funciones y form triggers (CMDBuild), Parameter (OpenMaint) (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar flujos de trabajo configurables según procesos y reglas de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ProcesoNegocio, Funciones y form triggers (CMDBuild), Workflow (CMDBuild), Aprobacion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar documentos, registros, evidencias y versiones asociados a las actividades del SGCC.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoGestion, DMS Alfresco (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Integrarse mediante interfaces con sistemas externos e importar/exportar información estructurada en formatos definidos, validando su integridad y respetando los permisos de acceso.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Grupos y privilegios (CMDBuild), Import/export y ETL (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ADM-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Mantener trazabilidad de usuarios, acciones, cambios, estados y registros relevantes del sistema.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoGestion, Historial de tarjetas (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar el análisis estratégico de factores internos y externos relevantes para la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analisis, FactorAnalisis&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar información de prospectiva, escenarios, tendencias y condiciones futuras relevantes para la planificación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analisis, FactorAnalisis&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Definir OEs, prioridades y resultados estratégicos de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoPlan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Desagregar objetivos estratégicos en niveles, resultados, hitos o compromisos según el modelo adoptado.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco, ElementoPlan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar indicadores y metas asociados a objetivos y prioridades estratégicas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoPlan, Indicador, MedicionIndicador&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar responsables, plazos, recursos y condiciones de ejecución asociados a las prioridades estratégicas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoPlan, AsignacionRecurso&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PGE-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Brindar apoyo integral durante todo el ciclo de vida del Plan Estratégico y de los Planes anuales de Acción asociados a cada objetivo estratégico, registrando todas las decisiones y los cambios derivados de esas decisiones.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan, Decision, Historial de tarjetas (CMDBuild), Workflow (CMDBuild), Aprobacion, Reuniones (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;RUG-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analisis, FactorAnalisis&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;EIE-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar la relación entre prioridades estratégicas, recursos disponibles y recursos requeridos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoPlan, AsignacionRecurso, Employee (OpenMaint), CI (OpenMaint), Consumable (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;EIE-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar la planificación y seguimiento de inversiones y recursos destinados a OEs.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Budget (OpenMaint), BudgetItem (OpenMaint), AsignacionRecurso&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;EIE-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar la capacidad disponible de recursos humanos frente a las necesidades derivadas de prioridades y planes.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Employee (OpenMaint), AsignacionRecurso, Vistas SQL (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;EIE-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analizar y visualizar el equilibrio entre prioridades, capacidad, recursos, inversiones y resultados esperados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analisis, Dashboards y reportes (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GDD-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar el Plan de Gestión del Desempeño, incluyendo la planificación de compromisos, actividades y resultados, y su seguimiento continuo en los diferentes niveles de la organización, manteniendo trazabilidad con los objetivos estratégicos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan, ElementoPlan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GDD-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar ciclos de revisión del desempeño y registrar desviaciones, decisiones, acciones de mejora y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Decision, Reuniones (OpenMaint), Hallazgo, Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GOCP-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan, Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GOCP-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar responsables, fechas, duración, prioridades, recursos y restricciones de las actividades planificadas, incluyendo recordatorios de tareas pendientes a sus responsables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;AsignacionRecurso, Employee (OpenMaint), CI (OpenMaint), Consumable (OpenMaint), Actividad, Notificaciones (EmailTemplate, HistorialEmail) (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GOCP-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar y comparar ejecución planificada, real, reprogramada y no planificada, midiendo los factores de estabilidad y equilibrio de procesos&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;RegistroEjecucion, Vistas SQL (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GOCP-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar resultados, evidencias, desviaciones y causas de actividades no ejecutadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild), Hallazgo, Resultado, Actividad, Lookups (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Crear y gestionar proyectos con objetivos, alcance, responsables, fechas, estado, patrocinador y justificación del negocio cuando aplique manteniendo su alineación y trazabilidad con los OEs y el Sistema de gestión vigente&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar estructura, fases, hitos, entregables, ciclos de vida predictivos, ágiles e hibridos según el proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;FaseProyecto, Actividad, Resultado&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar actividades, tareas, responsables y dependencias del proyecto y permitir backlogs, historias de usuario y sprints cuando corresponda&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Actividad, Vistas SQL (CMDBuild), FaseProyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar cronogramas, seguimiento del avance, planificación iterativa, hitos y pronósticos de finalización del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Actividad, FaseProyecto, Vistas SQL (CMDBuild), Proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar recursos, costos, necesidades, presu- puestos de referencia y seguimientos de desvia- ciones del proyecto incluyendo adquisiciones e información de proveedores asociadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;AsignacionRecurso, Employee (OpenMaint), CI (OpenMaint), Consumable (OpenMaint), Hallazgo, Budget (OpenMaint), BudgetItem (OpenMaint), AccountingMov (OpenMaint), PurchaseOrder (OpenMaint), Supplier (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar riesgos potenciales, problemas materializados, impedimentos, restricciones y oportunidades del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Hallazgo&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar cambios con evaluación de su impacto en: alcance, plazo, recursos, costos, calidad y valor esperado del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;SolicitudCambio, Aprobacion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-08&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar documentación, versiones, entregables, evidencias y conocimiento generado durante el proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-09&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar y registrar responsables, fechas, decisiones, acuerdos, compromisos asociados al proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Decision&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-10&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar seguimiento y evaluación de resultados, aceptación de entregables y cumplimiento de objetivos y beneficios del proyecto.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Resultado&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-11&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar los aprendizajes y conocimientos generados durante el ciclo de vida del proyecto, asociarlos al proyecto correspondiente y faiclitar su reutilización&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-12&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Vincular el proyecto con objetivos, procesos y conocimiento alineados a las entidades organizacionales, competencias y oportunidades de mejora&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, Proyecto&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PRO-13&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Capturar conocimiento explícito generado en las actividades de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Capturar conocimiento tácito, experiencias, prácticas y aprendizajes de las personas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Organizar, clasificar y relacionar conocimiento según estructuras configurables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Lookups (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar libros, papers, documentos, evidencias, registros, videos, charlas y fuentes asociados al conocimiento.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar la valoración de los usuarios sobre la utilidad práctica del conocimiento, considerando la frecuencia e importancia de su uso para resolver problemas, y permitir consultar los resultados para priorizar su mejora y reutilización versionada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild), Historial de tarjetas (CMDBuild), ValoracionUtilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar la transferencia y socialización del conocimiento, la cultura y los valores dentro de la organización.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Reuniones (OpenMaint), ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-08&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar aprendizajes, lecciones y experiencias derivados de la ejecución y mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ActivoConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;KN-09&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar un Plan de Manejo del Conocimiento incluyendo la planificación, ciclos de creación, transformación, validación, actualización y aplicación del conocimiento; registrando el contexto físico, virtual o digital en el que se genera y/o aplica.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan, MarcoMetodologico, DMS Alfresco (CMDBuild), Historial de tarjetas (CMDBuild), CicloConocimiento&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;TR-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Consultar y navegar transversalmente las relaciones existentes entre OEs, proyectos, procesos, activida- des, resultados, conocimiento, PTE, competencias y mejoras, permitiendo seguir la trazabilidad desde las experiencias que originan conocimiento hasta su aplicación mediante PTE, el desarrollo de competencias y los resultados obtenidos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, Grafo de relaciones (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;TR-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;TR-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Mantener trazabilidad entre conocimiento, competencias, personas y actividades de desarrollo.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, Grafo de relaciones (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;TR-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;TR-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Mantener historial de cambios, decisiones, versiones y estados de elementos gestionados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoGestion, Decision, Historial de tarjetas (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;TR-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, Grafo de relaciones (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE, DMS Alfresco (CMDBuild), CleaningActivity (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar versiones, revisiones, aprobación y vigencia de los PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Workflow (CMDBuild), Aprobacion, Reuniones (OpenMaint), VersionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Asociar cada PTE con los procesos, actividades, competencias, conocimiento y demás entidades necesarias para su aplicación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, PTE&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Utilizar los PTE como referencia para ejecutar actividades mediante la generación de POp´s&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Actividad, CleaningTask (OpenMaint), MaintProcess (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Identificar/registrar desviaciones, desperdicios, incidencias y oportunidades de mejora relacionadas con los PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Hallazgo&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Actualizar PTE a partir de resultados, aprendizajes, cambios y mejoras aprobadas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VersionPTE&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar y conservar evidencias de aplicación, revisión y evolución de cada PTE.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild), VersionPTE, Aprobacion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE-08&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Priorizar el levantamiento de PTE según su importancia estratégica y su frecuencia de uso operativo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;PTE&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar perfiles y competencias requeridas por roles y actividades.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;RolFuncional, Grupos y privilegios (CMDBuild), Competencia, CompetenciaRequerida&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar competencias actuales de las personas.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Employee (OpenMaint), CompetenciaPersona&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Identificar brechas entre competencias requeridas y disponibles.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Vistas SQL (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Definir planes de desarrollo para cerrar brechas de competencias.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan, Actividad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar actividades de capacitación, entrenamiento, práctica y desarrollo&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Actividad, ProgramaFormacion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar cursos, programas y otras modalidades de formación p.e. &quot;Onboarding&quot; incluyendo su documentación y versionamiento&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ProgramaFormacion, DMS Alfresco (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar calendarios y participantes de actividades de formación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Reuniones (OpenMaint), Participacion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-08&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar documentación, contenidos y versiones asociados a la formación.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-09&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar y evaluar los resultados y evidencias de aprendizaje y desarrollo, verificando el logro de los aprendizajes previstos.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild), Participacion&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-10&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar seguimiento individual del desarrollo de competencias.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;CompetenciaPersona, Plan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-11&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar el seguimiento del acompañamiento, la tutoría, el coaching y otros mecanismos de desarrollo mediante la práctica continua y el aprendizaje&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico, Reuniones (OpenMaint)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;COMP-12&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Asociar las competencias con los elementos de gestión necesarios para evaluar su desarrollo y aplicación, incluyendo desempeño, conocimiento, PTE y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, Competencia&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar, evaluar y priorizar oportunidades de mejora, determinando su tratamiento.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Hallazgo&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar problemas mediante su definición y análisis basado en evidencias, la identificación de causas, la determinación y seguimiento de acciones, y la verificación de resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;DMS Alfresco (CMDBuild), Hallazgo, Analisis, FactorAnalisis, Actividad, Resultado&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Gestionar iniciativas de mejora aprobadas desde su planificación hasta su cierre, registrando avances y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ElementoPlan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Brindar apoyo integral durante todo el ciclo de vida del Plan Anual de Acción para la Mejora Continua, incluyendo la definición de metas, la planificación de iniciativas, el seguimiento de resultados y su actualización, registrando las decisiones y los cambios correspondientes.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Plan, Decision, Historial de tarjetas (CMDBuild), ElementoPlan&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar y canalizar sugerencias, ideas y propuestas de personas y equipos, vinculándolas con oportunidades de mejora cuando corresponda.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Hallazgo&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Registrar los resultados y aprendizajes derivados de las acciones de mejora, facilitando su aprovechamiento en futuras mejoras.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;ActivoConocimiento, Resultado&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Asociar cada mejora con las entidades involucradas en su ejecución y evaluación, incluyendo conocimiento, competencias, PTE, procesos, proyectos y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-08&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Permitir configurar y aplicar diferentes métodos de mejora continua&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico, ComponenteMarco&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GMC-09&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analizar información histórica de múltiples casos de problemas y mejoras para identificar recurrencias, tendencias y patrones que permitan detectar oportunidades de mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analisis&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-01&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Configurar indicadores de gestión, desempeño, resultados y mejora.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Indicador&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-02&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Definir fórmulas, fuentes, metas, periodicidad y responsables de indicadores.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Indicador, MedicionIndicador&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-03&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Visualizar información mediante dashboards configurables según perfiles y necesidades.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Dashboards y reportes (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-04&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Generar reportes operativos, tácticos y estratégicos SGCC configurables.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Dashboards y reportes (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-05&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analizar tendencias, desviaciones, cumplimiento y comportamiento de indicadores.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MedicionIndicador, Analisis&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-06&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Relacionar indicadores con objetivos, proyectos, procesos, actividades y resultados.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;VinculoTrazabilidad, Indicador&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-07&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Facilitar análisis para toma de decisiones y priorización de acciones.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Analisis&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;border-top:1px solid #E5E7EB&quot;&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;GID-08&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;Permitir configurar vistas e indicadores específicos para diferentes niveles, áreas y métodos de gestión.&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;vertical-align:top&quot;&gt;MarcoMetodologico, Dashboards y reportes (CMDBuild)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#FFFFFF;strokeColor=#D1D5DB;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1400" height="2680" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>