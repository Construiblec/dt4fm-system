{"nodes": [{"id": "docs_pruebas_piloto_img_inf06_1_login_screenshot", "label": "Pilot Test Screenshot: DT4FM Login Page with DevTools Console", "file_type": "image", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pruebas_piloto_img_inf06_1_login_page", "label": "Construiblec Login Page (/login)", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centered card layout with brand logo, 'Bienvenido' heading, username/email + password fields, primary 'Entrar' button, secondary paths (forgot password, guest, resident sign-up). Single-column mobile-first design consistent with a PWA targeting phone users."}, {"id": "docs_pruebas_piloto_img_inf06_1_username_or_email_login", "label": "Login by Username or Email", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subtitle 'Ingresa con tu usuario o correo' indicates the identifier field accepts either a username (e.g. wilmer.palma) or an email, so the backend must resolve both forms of identity."}, {"id": "docs_pruebas_piloto_img_inf06_1_guest_access", "label": "Continue as Guest (Continuar como invitado)", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separated from the credential form by a divider ('o'), giving unauthenticated users (visitors / guests of the building) an entry path without an account. Likely the entry point to the guest portal / magic-link flow."}, {"id": "docs_pruebas_piloto_img_inf06_1_resident_registration", "label": "Resident Self-Registration (Reg\u00edstrate)", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prompt '\u00bfEres residente y no tienes cuenta? Reg\u00edstrate' shows residents can self-register rather than being provisioned only by an administrator."}, {"id": "docs_pruebas_piloto_img_inf06_1_password_recovery", "label": "Forgot Password Link (\u00bfOlvidaste tu contrase\u00f1a?)", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pruebas_piloto_img_inf06_1_pwa_install_banner", "label": "Custom PWA Install Banner (Instala Construiblec)", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app renders its own top banner ('Instala Construiblec \u2014 Acceso directo y m\u00e1s r\u00e1pido desde tu inicio' with an 'Instalar' button and dismiss X) instead of the browser's native mini-infobar. This is done by intercepting the beforeinstallprompt event, calling preventDefault(), and deferring the prompt until the user clicks 'Instalar'. Trade-off: full control over branding/copy in Spanish vs. the console warning about the suppressed native banner."}, {"id": "docs_pruebas_piloto_img_inf06_1_beforeinstallprompt_warning", "label": "Console Warning: beforeinstallprompt preventDefault() without prompt()", "file_type": "rationale", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrome DevTools logs 'Banner not shown: beforeinstallpromptevent.preventDefault() called. The page must call beforeinstallpromptevent.prompt() to show the banner.' at login:1. This is the expected side effect of a custom install UX: the page stores the deferred event and only calls prompt() on user action. Flagged as 1 issue in the Issues panel but is not an error."}, {"id": "docs_pruebas_piloto_img_inf06_1_vercel_deployment", "label": "Vercel Deployment (dt4fm-system-f7cc.vercel.app)", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frontend under pilot test is served from a Vercel preview/production host (dt4fm-system-f7cc.vercel.app), served over HTTPS which is a precondition for PWA installability."}, {"id": "docs_pruebas_piloto_img_inf06_1_construiblec_branding", "label": "Construiblec Brand Identity", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The DT4FM system is presented to end users under the Construiblec brand: tab title 'Construiblec', blue circuit-style building logo, uppercase 'CONSTRUIBLEC' wordmark, blue primary color used for the banner and the Entrar button."}, {"id": "docs_pruebas_piloto_img_inf06_1_pilot_user_wilmer_palma", "label": "Pilot Test User wilmer.palma", "file_type": "concept", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_pruebas_piloto_img_inf06_1_pilot_test_report_06", "label": "Pilot Test Report 06 (informe 06)", "file_type": "document", "source_file": "docs/pruebas-piloto/img-inf06-1.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inferred from the filename pattern img-inf06-1: first image attached to pilot-test report number 06 under docs/pruebas-piloto."}], "edges": [{"source": "docs_pruebas_piloto_img_inf06_1_login_sc