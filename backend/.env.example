# =============================================================================
# Variables de entorno del backend DT4FM
#
# Marcadas como [OBLIGATORIA] las que, si faltan, rompen alguna funcionalidad.
# El resto tienen valor por defecto en el código.
# =============================================================================

# ── OpenMAINT ─────────────────────────────────────────────────────── [OBLIGATORIAS]
# URL del VPS en la nube (producción/staging)
# OPENMAINT_URL=http://187.77.250.224:8090/cmdbuild/services/rest/v3

# URL local (desarrollo)
OPENMAINT_URL=http://187.77.250.224:8091/cmdbuild/services/rest/v3
OPENMAINT_USERNAME=admin
OPENMAINT_PASSWORD=12345

# Puerto del servidor HTTP (defecto: 3000)
PORT=3000

# Exponer Swagger en /docs. Solo "true" lo activa; en producción déjalo apagado.
ENABLE_DOCS=false


# ── Hostaway OAuth 2.0 ────────────────────────────────────────────────────────
HOSTAWAY_CLIENT_ID=149703
HOSTAWAY_CLIENT_SECRET=your_client_secret_here

# Usar datos mock en lugar de la API real (true | false)
HOSTAWAY_USE_MOCK=false


# ── Contifico (facturación) ───────────────────────────────────────────────────
CONTIFICO_BASE_URL=
CONTIFICO_API_KEY=
CONTIFICO_POS_TOKEN=
CONTIFICO_PRODUCTO_ID=


# ── Notificaciones por correo ─────────────────────────────────────────────────
# Proveedor de correo activo: "smtp" | "resend".
#
# IMPORTANTE en Render y plataformas similares: bloquean las conexiones SMTP
# salientes, así que ahí hay que usar "resend", que envía por API HTTP.
MAIL_PROVIDER=smtp

# ── Opción A: Resend (obligatoria en Render) ──────────────────────────────────
# El dominio del remitente debe estar verificado en Resend (registros SPF y
# DKIM en el DNS); si no, los correos caen en spam o son rechazados.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DT4FM <no-reply@tu-dominio.com>
# RESEND_FROM es un alias antiguo de RESEND_FROM_EMAIL; solo se lee si el otro
# está vacío. No hace falta definir ambas.
# RESEND_FROM=

# ── Opción B: SMTP ────────────────────────────────────────────────────────────
# Ejemplos:
#   Brevo:    smtp-relay.brevo.com  / puerto 587 / SECURE=false
#   Mailtrap: sandbox.smtp.mailtrap.io / puerto 2525 / SECURE=false
#
# OJO: Mailtrap "sandbox" NO entrega los correos al destinatario real, los
# captura en una bandeja de pruebas. Sirve para desarrollo, no para producción.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
# Remitente por defecto (formato: "Nombre <correo@dominio.com>")
SMTP_FROM=DT4FM <no-reply@example.com>

# Pausa en milisegundos entre cada envío del lote (control de ritmo).
MAIL_THROTTLE_MS=200

# Registrar cada envío exitoso como card en la clase HistorialEmail de
# openMAINT (true por defecto; "false" lo desactiva).
HISTORIAL_EMAIL_ENABLED=true

# Correo administrativo que recibe aviso de cada incidente nuevo.
# Acepta varios separados por coma. Vacío = no se notifica a nadie.
INCIDENT_NOTIFICATION_EMAIL=admin@example.com


# ── Recuperación de contraseña ────────────────────────────────── [OBLIGATORIAS]
# URL pública del FRONTEND (no la del backend): el correo enlaza a la pantalla
# /reset-password, que vive en el frontend. Sin barra final.
#   local      http://localhost:5173
#   staging    https://dt4fm-staging.vercel.app
#   producción https://dt4fm-system-f7cc.vercel.app
APP_BASE_URL=http://localhost:5173

# Secreto con el que se firman los enlaces. Cadena larga y aleatoria, distinta
# por ambiente. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si falta, la recuperación de contraseña queda deshabilitada (se avisa en los
# logs al arrancar). Cambiarla invalida todos los enlaces ya enviados.
PASSWORD_RESET_SECRET=


# ── Clase de plantillas de correo en openMAINT ────────────────────────────────
# Clase custom donde el backend guarda sus plantillas. Ojo: es distinta de
# `_EmailTemplate` (con guion bajo), que es la nativa de openMAINT y la usa el
# widget manageEmail del workflow, no este backend.
OPENMAINT_TEMPLATE_CLASS=EmailTemplate


# ── Schedulers ────────────────────────────────────────────────────────────────
# Todos apagados salvo que valgan exactamente "true". Los de reuniones y pagos
# ENVÍAN CORREO: revisarlos antes de apuntar a un proveedor que entregue de
# verdad, o saldrán correos reales en lote.
#
# HOUR (0-23) y MINUTE (0-59) definen la hora local de ejecución diaria.

# Sincronización Hostaway → openMAINT (no envía correo)
HOSTAWAY_SCHEDULER_ENABLED=false
HOSTAWAY_SCHEDULER_HOUR=0
HOSTAWAY_SCHEDULER_MINUTE=0

# Recordatorios de reuniones — ENVÍA CORREO
MEETING_REMINDER_SCHEDULER_ENABLED=false
MEETING_REMINDER_SCHEDULER_HOUR=8
MEETING_REMINDER_SCHEDULER_MINUTE=0
# Días de antelación del recordatorio
MEETING_REMINDER_DAYS_BEFORE=1

# Recordatorios de pagos — ENVÍA CORREO
PAYMENTS_SCHEDULER_ENABLED=false
PAYMENTS_SCHEDULER_HOUR=8
PAYMENTS_SCHEDULER_MINUTE=0

# Facturación
BILLING_SCHEDULER_ENABLED=false
BILLING_SCHEDULER_HOUR=8
BILLING_SCHEDULER_MINUTE=50


# ── Calendario ────────────────────────────────────────────────────────────────
# Zona horaria para las reservas de áreas comunes.
CALENDAR_TIMEZONE=America/Guayaquil

# ── Base de datos propia (Neon) ──────────────────────────────── 
# Cada entorno usa su PROPIA rama de Neon y nunca la comparte: staging
# migrando contra la rama de producción reescribiría datos reales.
#   producción -> rama `production`   staging -> rama `development`
# En local no se usa Neon sino el contenedor: `docker compose up -d`, y ambas
# cadenas quedan como postgresql://dt4fm:dt4fm@localhost:5555/dt4fm
#
# Cadena CON pooler (host ...-pooler...): la que usa la app en runtime.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-west-2.aws.neon.tech/dt4fm?sslmode=require

# Cadena SIN pooler: solo para migraciones. El pooler rompe los locks de DDL.
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.us-west-2.aws.neon.tech/dt4fm?sslmode=require

# ── Notificaciones push (Web Push / VAPID) ──────────────────── [OBLIGATORIAS]
# Generar el par UNA sola vez con:
#   npx web-push generate-vapid-keys
#
# NO ROTAR: las suscripciones quedan atadas a la clave pública con la que se
# crearon. Cambiarlas invalida todas y obliga a que cada usuario vuelva a
# activar las notificaciones. Respaldarlas fuera del panel de Render.
#
# La pública también va al frontend como VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige la spec de Web Push (mailto: o https:).
VAPID_SUBJECT=mailto:no-reply@tu-dominio.com

# Schedulers de push: avisos de preventivos por vencer y limpiezas atrasadas.
# Solo "true" los activa, igual que el resto de schedulers.
PUSH_SCHEDULER_ENABLED=true
