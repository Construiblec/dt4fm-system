# =============================================================================
# Variables de entorno del backend DT4FM
#
# Los valores de abajo son los del entorno de DESARROLLO.
# Marcadas como [OBLIGATORIAS] las que, si faltan, rompen alguna funcionalidad.
# El resto tienen valor por defecto en el código.
#
# Secretos: cada uno distinto por entorno. Para generarlos todos de una vez:
#   node -e "const c=require('crypto');const b=n=>c.randomBytes(n).toString('base64');const h=n=>c.randomBytes(n).toString('hex');console.log(['PASSWORD_RESET_SECRET='+b(48),'GUEST_MAGICLINK_SECRET='+b(48),'APP_SESSION_KEY='+b(32),'ACCESS_PIN_KEY='+b(32),'ACCESS_PIN_FINGERPRINT_KEY='+b(32),'IOT_WEBHOOK_SECRET='+h(32),'HOSTAWAY_WEBHOOK_USER='+h(16),'HOSTAWAY_WEBHOOK_SECRET='+h(32),'GUEST_LINK_WEBHOOK_SECRET='+h(32)].join('\n'))"
# =============================================================================

# ── OpenMAINT ─────────────────────────────────────────────────────── [OBLIGATORIAS]
# URL de la API REST de la instancia de openMAINT de este entorno.
OPENMAINT_URL=<url-openmaint-dev>/cmdbuild/services/rest/v3
OPENMAINT_USERNAME=<usuario>
OPENMAINT_PASSWORD=<password>

# Clase custom donde el backend guarda sus plantillas. Ojo: es distinta de
# `_EmailTemplate` (con guion bajo), que es la nativa de openMAINT y la usa el
# widget manageEmail del workflow, no este backend.
OPENMAINT_TEMPLATE_CLASS=EmailTemplate

# `_id` del Employee de openMAINT que figura como solicitante de las
# incidencias que reportan los huéspedes (el empleado "Portal Huésped").
OPENMAINT_GUEST_REQUESTER_ID=<_id Employee "Portal Huésped">

# _id del Employee "Iot Sistema" en openMAINT. Figura como solicitante de los
# correctivos automáticos; `Requester` es obligatorio en CM01-Opening.
OPENMAINT_IOT_REQUESTER_ID=<_id Employee "Iot Sistema">

# Site de respaldo para cuando el código de activo no resuelve o es ambiguo.
#   3019998 = P - Pradera   3025058 = I - Inglaterra   1456213 = P - Prueba
OPENMAINT_IOT_FALLBACK_SITE_ID=1456213


# ── General ───────────────────────────────────────────────────────────────────
# Nivel mínimo: error | warn | log | debug | verbose (defecto: log).
#   log    lo normal: una línea por petición y los eventos de negocio.
#   debug  además cada llamada a openMAINT y Contifico, y el arranque completo
#          de Nest. Para depurar un rato; en Render cambiarlo redespliega.
LOG_LEVEL=log

# "json" escribe una línea JSON por evento (con el campo `rid`), para enviar
# los logs a una herramienta externa. Vacío: texto legible en el panel.
LOG_FORMAT=

# Orígenes con permiso de llamar a la API desde el navegador, separados por
# coma. Vacía: ningún navegador puede llamar a la API (el código no trae
# dominios por defecto).
# Esta variable es la única perilla de CORS que hay que tocar.
CORS_ALLOWED_ORIGINS=

# [OBLIGATORIA] URL pública del FRONTEND (no la del backend): el correo de
# recuperación enlaza a /reset-password y el del huésped a /g/<código>, que
# viven en el frontend. Sin barra final.
APP_BASE_URL=

# Zona horaria para las reservas de áreas comunes.
CALENDAR_TIMEZONE=America/Guayaquil


# ── Base de datos propia ───────────────────────────────────────────────
# Cada entorno usa su PROPIA rama y nunca la comparte: staging
# migrando contra la rama de producción reescribiría datos reales.
#   producción -> rama `production`   staging -> rama `development`
# En local no se usa esta base de datos sino el contenedor: `docker compose up -d`, y ambas
# cadenas quedan como postgresql://dt4fm:dt4fm@localhost:5555/dt4fm
#
# Con `sslmode=require` basta: el backend la reescribe a `verify-full`.
#
# Cadena CON pooler (host ...-pooler...): la que usa la app en runtime.
DATABASE_URL=<cadena CON -pooler>?sslmode=require

# Cadena SIN pooler: solo para migraciones. El pooler rompe los locks de DDL.
DATABASE_URL_DIRECT=<cadena SIN -pooler>?sslmode=require


# ── Hostaway ──────────────────────────────────────────────────────────────────
# Credenciales OAuth 2.0 de la API.
HOSTAWAY_CLIENT_ID=
HOSTAWAY_CLIENT_SECRET=<secret de Hostaway>

# Usar datos mock en lugar de la API real (true | false). 
# La sincronización de limpiezas necesita las reservas reales.
HOSTAWAY_USE_MOCK=false

# Basic Auth con la que Hostaway llama a nuestro webhook. Deben coincidir con
# lo configurado en el panel de Hostaway: si se cambian aquí, cambiarlas allí.
HOSTAWAY_WEBHOOK_USER=
HOSTAWAY_WEBHOOK_SECRET=


# ── Contifico (facturación) ───────────────────────────────────────────────────
# "true" devuelve facturas simuladas (id MOCK-…) sin llamar a Contifico.
# OBLIGATORIO fuera de producción (local y desarrollo): cada documento que
# Contifico acepta es una factura real. Solo producción lo deja en "false".
CONTIFICO_USE_MOCK=true
CONTIFICO_BASE_URL=<url>
CONTIFICO_PRODUCTO_ID=<id>

# Solo producción. Fuera de ella no se definen: así, si alguien apaga el mock
# por error, Contifico rechaza la llamada en vez de emitir una factura real.
# CONTIFICO_API_KEY=
# CONTIFICO_POS_TOKEN=


# ── Notificaciones por correo ─────────────────────────────────────────────────
# Proveedor de correo activo: "smtp" | "resend".
#
# IMPORTANTE en Render y plataformas similares: bloquean las conexiones SMTP
# salientes, así que ahí hay que usar "resend", que envía por API HTTP.
MAIL_PROVIDER=resend

# ── Opción A: Resend (obligatoria) ──────────────────────────────────
# El dominio del remitente debe estar verificado en Resend (registros SPF y
# DKIM en el DNS); si no, los correos caen en spam o son rechazados.
RESEND_API_KEY=<api key>
RESEND_FROM_EMAIL=DT4FM Dev <no-reply@tu-dominio-verificado>

# ── Opción B: SMTP (solo en local) ────────────────────────────────────────────
# Ejemplos:
#   Brevo:    smtp-relay.brevo.com  / puerto 587 / SECURE=false
#   Mailtrap: sandbox.smtp.mailtrap.io / puerto 2525 / SECURE=false
#
# OJO: Mailtrap "sandbox" NO entrega los correos al destinatario real, los
# captura en una bandeja de pruebas. Sirve para desarrollo, no para producción.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Remitente por defecto (formato: "Nombre <correo@dominio.com>")
# SMTP_FROM=DT4FM <no-reply@example.com>

# Red de seguridad fuera de producción: si tiene valor, TODO correo (schedulers,
# avisos de incidentes, recuperación de contraseña, enlace del huésped) se
# entrega a este único buzón, con el destinatario original en el asunto.
# OBLIGATORIO en local y desarrollo, que leen direcciones reales de openMAINT.
# En producción, vacío.
MAIL_REDIRECT_TO=<buzón de pruebas del equipo>

# Pausa en milisegundos entre cada envío del lote (control de ritmo).
MAIL_THROTTLE_MS=200

# Registrar cada envío exitoso como card en la clase HistorialEmail de
# openMAINT (true por defecto; "false" lo desactiva).
HISTORIAL_EMAIL_ENABLED=true

# Correo administrativo que recibe aviso de cada incidente nuevo.
# Acepta varios separados por coma. Vacío = no se notifica a nadie.
# Fuera de producción, un buzón de pruebas, nunca uno personal.
INCIDENT_NOTIFICATION_EMAIL=<buzón de pruebas>


# ── Secretos de enlaces y sesiones ────────────────────────────── [OBLIGATORIAS]
# Firma los enlaces de recuperación de contraseña. Cadena larga y aleatoria
# (48 bytes en base64). Si falta, la recuperación queda deshabilitada (se avisa
# en los logs al arrancar). Cambiarla invalida todos los enlaces ya enviados.
PASSWORD_RESET_SECRET=

# Firma los enlaces del huésped, que no tiene cuenta: entra a su portal con un
# enlace corto (APP_BASE_URL/g/<código>) que se canjea por el token en
# /guest/dashboard. Distinta de PASSWORD_RESET_SECRET a propósito: son
# capacidades separadas y filtrar una no debe entregar la otra. Si falta, el
# portal queda deshabilitado. Cambiarla invalida todos los enlaces ya enviados.

GUEST_MAGICLINK_SECRET=

# openMAINT cierra una sesión tras una hora sin uso. Con «Mantener la sesión
# iniciada», el backend la mantiene viva (keepalive cada 20 min) hasta 30 días
# sin abrir la app, y al cambiar la contraseña cierra las de los demás
# dispositivos. Sin ella el login funciona como antes, sin recordar nada.
# Rotarla solo obliga a volver a iniciar sesión en los dispositivos recordados.
APP_SESSION_KEY=

# El keepalive (cada 20 min, desde memoria: no consulta la base) y la limpieza
# de sesiones vencidas. Con "false" las sesiones recordadas caducan a
# la hora, como antes. Solo "true" lo activa, igual que el resto de schedulers.
APP_SESSION_KEEPALIVE_ENABLED=true


# ── Entrega del enlace del huésped ────────────────────────────────────────────
# Por dónde le llega el enlace al huésped cuando se proyecta una reserva nueva.
#   none     apagado. Es el defecto: un despliegue recién configurado no manda
#            enlaces a ninguna parte hasta que alguien lo decida. Cada estancia
#            queda igualmente registrada en guest_link_delivery como `failed`
#            con motivo `channel_disabled`, para poder reenviar después.
#   hostaway reservas de canal (Airbnb, Booking, Vrbo…): mensaje en la
#            conversación de Hostaway, que lo relaya al chat del canal. Reservas
#            directas o sin canal conocido: correo al guestEmail con el proveedor
#            de MAIL_PROVIDER. Si el mensaje falla y hay correo, se usa el correo.
#            Usa las credenciales OAuth de arriba; HOSTAWAY_USE_MOCK lo simula.
#            OJO al activarlo: toda estancia vigente sin envío correcto recibe el
#            enlace en su próxima actualización o en el barrido de las 05:00.
#   email    siempre por correo al guestEmail de la reserva. Las reservas de
#            Airbnb suelen llegar sin correo y quedan como `failed` / `no_email`.
#   webhook  POST con el enlace a GUEST_LINK_WEBHOOK_URL. Lo que haya al otro
#            lado (n8n, un proveedor de WhatsApp) se encarga de llevarlo.
GUEST_LINK_CHANNEL=none

# Tras un envío fallido no se reintenta automáticamente antes de estos minutos
# (defecto: 60). Los reintentos vienen de cada reservation.updated y del barrido
# diario; el reenvío manual no espera.
# 0 desactiva la espera.
GUEST_LINK_RETRY_COOLDOWN_MINUTES=60

# Solo con GUEST_LINK_CHANNEL=webhook. Para probar, una URL de webhook.site
# muestra lo que llega. El payload lleva la URL del portal; NUNCA el PIN.
GUEST_LINK_WEBHOOK_URL=

# Opcional. Si está, cada POST va firmado en la cabecera X-DT4FM-Signature
# (sha256=<hmac del cuerpo>) para que el receptor verifique que somos nosotros.
GUEST_LINK_WEBHOOK_SECRET=


# ── Notificaciones push (Web Push / VAPID) ──────────────────── [OBLIGATORIAS]
# Generar el par UNA sola vez con:
#   npx web-push generate-vapid-keys
#
# NO ROTAR: las suscripciones quedan atadas a la clave pública con la que se
# crearon. Cambiarlas invalida todas y obliga a que cada usuario vuelva a
# activar las notificaciones. Respaldarlas fuera del panel de Render.
#
# Un par distinto por entorno; el de producción no debe existir en ningún otro
# sitio. El frontend no se configura: pide la pública a /push/vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exige la spec de Web Push (mailto: o https:).
VAPID_SUBJECT=mailto:<buzón del equipo>

# Schedulers de push: avisos de preventivos por vencer y limpiezas atrasadas.
# Solo "true" los activa, igual que el resto de schedulers.
PUSH_SCHEDULER_ENABLED=false


# ── Schedulers ────────────────────────────────────────────────────────────────
# Todos apagados salvo que valgan exactamente "true". Los de reuniones y pagos
# ENVÍAN CORREO: fuera de producción, encenderlos solo con MAIL_REDIRECT_TO
# definido, o saldrán correos reales en lote. El de facturación emite facturas
# reales: fuera de producción, solo con CONTIFICO_USE_MOCK=true.
#
# HOUR (0-23) y MINUTE (0-59) definen la hora local de ejecución diaria.

# Sincronización Hostaway → openMAINT (no envía correo). Encenderlo solo si
# este entorno tiene su propio openMAINT: si escribe en el de producción,
# duplica las tareas de limpieza.
HOSTAWAY_SCHEDULER_ENABLED=false
HOSTAWAY_SCHEDULER_HOUR=0
HOSTAWAY_SCHEDULER_MINUTE=0

# Recordatorios de reuniones — ENVÍA CORREO
MEETING_REMINDER_SCHEDULER_ENABLED=false
MEETING_REMINDER_SCHEDULER_HOUR=8
MEETING_REMINDER_SCHEDULER_MINUTE=0
# Días de antelación del recordatorio
MEETING_REMINDER_DAYS_BEFORE=1

# Recordatorios de pagos — ENVÍA CORREO
PAYMENTS_SCHEDULER_ENABLED=false
PAYMENTS_SCHEDULER_HOUR=8
PAYMENTS_SCHEDULER_MINUTE=0

# Facturación — EMITE FACTURAS
BILLING_SCHEDULER_ENABLED=false
BILLING_SCHEDULER_HOUR=8
BILLING_SCHEDULER_MINUTE=50


# ── Alarmas IoT ───────────────────────────────────────────────── [OBLIGATORIAS]
# Secreto compartido con el servidor IoT, que lo envía en la cabecera
# X-IoT-Secret. Vacío ⇒ POST /iot/alarms responde 503 en vez de quedar abierto.
IOT_WEBHOOK_SECRET=

# Reintentos ante fallo de openMAINT antes de devolver 502. La Raspberry envía
# cada alarma UNA sola vez y no reintenta, así que el backend insiste por ella.
IOT_CREATE_MAX_ATTEMPTS=3


# ── Control de accesos (PINes) ────────────────────────────────── [OBLIGATORIAS]
# Cifrado del PIN en reposo (AES-256-GCM). 32 bytes en base64. Rotarla exige
# re-cifrar la tabla; no se cambia sin migración.
ACCESS_PIN_KEY=

# Clave del HMAC de la huella del PIN. DISTINTA de la anterior, para que
# comprometer la huella no ayude a descifrar. Misma forma de generarla.
ACCESS_PIN_FINGERPRINT_KEY=

# "true" responde desde access-iot.mock.ts sin salir a la red; obligatorio en
# las suites E2E. Con "false", mientras los gateways no implementen las
# operaciones, las credenciales quedan unreachable y el inventario y la apertura
# responden 404 not_found para cualquier puerta.
ACCESS_IOT_USE_MOCK=true

# VPS central de accesos, sin barra final.
ACCESS_IOT_URL=<url VPS accesos, sin barra final>

# Service token de Cloudflare Access que el backend presenta, con el formato
# <client-id>:<client-secret>. Sin los dos puntos responde 503. Con el mock
# activo no se usa.
ACCESS_IOT_TOKEN=<client-id>:<client-secret>

# Longitud del PIN (4-8, defecto: 4). 4 por decisión del cliente: son 10 000
# combinaciones.
ACCESS_PIN_LENGTH=4

# Días antes de que un PIN liberado pueda reasignarse (defecto: 30). El huésped
# anterior lo recuerda, y una cerradura no distingue memoria de autorización.
ACCESS_PIN_COOLDOWN_DAYS=30

# Reintentos de sincronización antes de marcar la credencial como failed
# (defecto: 5).
ACCESS_SYNC_MAX_ATTEMPTS=5

# Expone GET /access/credentials/:id/pin. Apagarlo en producción.
ACCESS_ALLOW_PIN_REVEAL=true

# Barridos de accesos (expiración, conciliación y purga). Solo "true" los activa.
ACCESS_SCHEDULER_ENABLED=true

# Apertura remota de la barrera vehicular (portal del huésped y panel CAV).
# POST /v1/devices/{id}/trigger: un pulso; «Abrir» y «Cerrar» son fases de interfaz.
ACCESS_REMOTE_OPEN_ENABLED=true

# Tiempos de cada barrera por buildingId, medidos en sitio. La ventana de cierre
# (quien abrió puede pulsar «Cerrar») termina antes del cierre automático (desde
# el pulso hasta que seguro bajó sola). Un edificio sin tiempos no ofrece el botón.
ACCESS_VEHICULAR_GATE_TIMINGS={"3025058":{"closeWindowSeconds":40,"autoCloseSeconds":90}}

# Respaldo de las horas de check-in y check-out (defecto: 15 y 11): manda el
# checkInTime de la propia reserva, que Hostaway da por reserva y no es igual
# en todos los listings. Estas solo se usan si la reserva no las trae.
ACCESS_CHECKIN_HOUR=15
ACCESS_CHECKOUT_HOUR=11

# Márgenes en horas (defecto: 3 y 3), que se aplican siempre: el PIN y el
# portal funcionan desde LEAD horas antes de la llegada hasta GRACE horas
# después de la salida.
ACCESS_GUEST_LEAD_HOURS=3
ACCESS_GUEST_GRACE_HOURS=3

# Videovigilancia en vivo (panel CAV). Usa la misma VPS: ACCESS_IOT_URL/TOKEN/USE_MOCK.
# GET /v1/cameras y POST /v1/cameras/{id}/live-sessions. Cada sesión queda en
# live_view_request. Ver docs/videovigilancia/README.md.
LIVE_VIDEO_ENABLED=false
