# ── OpenMAINT ────────────────────────────────────────────────────────────────
OPENMAINT_URL=http://187.77.250.224:8090/cmdbuild/services/rest/v3


#OPENMAINT_URL=http://localhost:8090/cmdbuild/services/rest/v3
OPENMAINT_USERNAME=admin
OPENMAINT_PASSWORD=your_password_here

# ── Hostaway OAuth 2.0 ────────────────────────────────────────────────────────
HOSTAWAY_CLIENT_ID=149703
HOSTAWAY_CLIENT_SECRET=your_client_secret_here

# Usar datos mock en lugar de la API real (true | false)
HOSTAWAY_USE_MOCK=false

# ── Scheduler diario (Hostaway → OpenMAINT) ───────────────────────────────────
# Habilitar sincronización automática diaria (true | false)
HOSTAWAY_SCHEDULER_ENABLED=false
# Hora de ejecución en hora local del servidor (0-23, defecto: 0)
HOSTAWAY_SCHEDULER_HOUR=0
# Minuto de ejecución (0-59, defecto: 0)
HOSTAWAY_SCHEDULER_MINUTE=0

# ── Notificaciones por correo ─────────────────────────────────────────────────
# Proveedor de correo activo. Por ahora solo "smtp" (sirve para Brevo,
# Mailtrap, Amazon SES, Gmail, etc. cambiando las credenciales de abajo).
MAIL_PROVIDER=smtp

# Configuración SMTP. Ejemplos:
#   Brevo:    smtp-relay.brevo.com  / puerto 587 / SECURE=false
#   Mailtrap: sandbox.smtp.mailtrap.io / puerto 2525 / SECURE=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
# Remitente por defecto (formato: "Nombre <correo@dominio.com>")
SMTP_FROM=DT4FM <no-reply@example.com>

# Pausa en milisegundos entre cada envío del lote (control de ritmo).
MAIL_THROTTLE_MS=200

# ── Clase de plantillas y lookups en openMAINT ────────────────────────────────
# Nombre de la clase custom donde se guardan las plantillas de correo.
OPENMAINT_TEMPLATE_CLASS=EmailTemplate
# Códigos del lookup OccupancyType de la clase Tenant para filtrar destinatarios.
# Déjalos vacíos y el envío irá a todos los Tenant.
OPENMAINT_OCCUPANCY_OWNER_CODE=
OPENMAINT_OCCUPANCY_TENANT_CODE=
